          "name": "T15 - Processar Pagamento Mock Aprovado (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"idempotencyKey\", \"idemp-aprovado-\" + Date.now());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Pagamento Aprovado e Pedido em PREPARACAO\", function () {",
                  "    pm.expect(json.statusTransacao).to.eql(\"APROVADO\");",
                  "    pm.expect(json.statusPedidoAtual).to.eql(\"PREPARACAO\");",
                  "    pm.expect(json.transacaoId).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
