# Configurações de Ambiente - Raízes do Nordeste Back-End
# Copie este arquivo para .env na raiz do projeto (não versione o arquivo .env)

# Spring Profile Ativo (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Banco de Dados MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=raizes_nordeste_db
MYSQL_USER=raizes_user
MYSQL_PASSWORD=raizes_pass_segura
MYSQL_ROOT_PASSWORD=root_pass_segura

# Segurança JWT (Assinatura HS256 com chave segura de 256 bits ou mais)
JWT_SECRET=raizes_do_nordeste_chave_secreta_jwt_para_ambiente_de_desenvolvimento_2026_segura
JWT_EXPIRATION_HOURS=8
